{
  "mcp": {
    "servers": {
      "playwright": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--output-dir=.playwright-mcp/artifacts"
        ],
        "timeoutMs": 60000
      }
    }
  }
}
