meta {
  name: Get Property Recurring Operations
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/properties/{{propertyId}}/recurring-operations
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session and a propertyId. Run properties/create first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have items array", function() {
    expect(res.body.items).to.be.an("array");
  });
}
