meta {
  name: Delete Property Detach
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/properties/{{propertyId}}?mode=detach
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session and a propertyId. Run properties/create first.
  // WARNING: this deletes {{propertyId}}. Its leases, operations, recurring
  // operations and reminders survive with property_id = null, recurring
  // operations are paused. Re-run properties/create to get a fresh object
  // before running other delete scenarios (seq 10, 12-15).
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 204", function() {
    expect(res.status).to.equal(204);
  });

  // Side effect check: run "get property after delete" (seq 16) right after
  // this request — the deleted property must return 404.
}
