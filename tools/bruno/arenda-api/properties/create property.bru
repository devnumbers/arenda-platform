meta {
  name: Create Property
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{propertyName}}",
    "type": "{{propertyType}}",
    "address": "{{propertyAddress}}",
    "description": "{{propertyDescription}}"
  }
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  // Save the created property id for subsequent property requests.
  if (res.body && res.body.id) {
    bru.setVar("propertyId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
