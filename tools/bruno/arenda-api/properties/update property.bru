meta {
  name: Update Property
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/properties/{{propertyId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{propertyName}} Updated",
    "description": "Updated description"
  }
}

script:pre-request {
  // Requires an authenticated session and a propertyId. Run properties/create first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("propertyId") || bru.getVar("propertyId"));
  });
}
