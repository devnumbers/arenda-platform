meta {
  name: Archive Property
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/properties/{{propertyId}}/archive
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session and a propertyId. Run properties/create first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should be archived", function() {
    expect(res.body.status).to.equal("archived");
  });
}
