meta {
  name: Delete Property Open Lease Blocked Detach
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/properties/{{propertyId}}?mode=detach
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session and a propertyId with an OPEN lease.
  // Setup: run properties/create, then tenant-contacts/create tenant contact,
  // then leases/create lease. An open lease blocks BOTH delete modes (409) —
  // the cascade twin of this case is seq 12.
  // Does not delete the object, safe to re-run. Run it before seq 10/11
  // (they delete {{propertyId}}) or recreate the property afterwards.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 409 when property has open lease", function() {
    expect(res.status).to.equal(409);
  });
}
