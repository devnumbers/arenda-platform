meta {
  name: Admin - Send Phone Code
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/phone/send
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{adminPhone}}"
  }
}

tests {
  test("should return 204", function() {
    expect(res.status).to.equal(204);
  });
}
