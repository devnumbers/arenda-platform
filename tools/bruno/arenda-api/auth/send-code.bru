meta {
  name: Send Phone Code
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/send
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{phone}}"
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
}
