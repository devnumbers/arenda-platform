meta {
  name: Verify Phone Code
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/phone/verify
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{phone}}",
    "code": "679425"
  }
}

script:post-response {
  // Extract session_id from Set-Cookie so subsequent requests can authenticate.
  const setCookie = res.getHeader("set-cookie");
  if (setCookie) {
    const raw = Array.isArray(setCookie) ? setCookie[0] : setCookie;
    const match = raw.match(/session_id=([^;]+)/);
    if (match) {
      bru.setEnvVar("session_id", match[1]);
      bru.setVar("session_id", match[1]);
      console.log("saved session_id =", match[1]);
      console.log("session_id saved");
    }
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should have user id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
