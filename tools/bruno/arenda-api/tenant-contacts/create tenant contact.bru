meta {
  name: Create Tenant Contact
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{tenantContactName}}",
    "surname": "{{tenantContactSurname}}",
    "patronymic": "{{tenantContactPatronymic}}",
    "phone": "{{tenantContactPhone}}",
    "email": "{{tenantContactEmail}}",
    "comment": "{{tenantContactComment}}"
  }
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  // Save the created tenant contact id for subsequent tenant contact requests.
  if (res.body && res.body.id) {
    bru.setEnvVar("tenantContactId", res.body.id);
    bru.setVar("tenantContactId", res.body.id);
    console.log("saved tenantContactId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have tenant contact id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
