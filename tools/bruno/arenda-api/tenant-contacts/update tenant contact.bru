meta {
  name: Update Tenant Contact
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/tenant-contacts/{{tenantContactId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{tenantContactUpdatedName}}",
    "phone": "{{tenantContactUpdatedPhone}}",
    "comment": "{{tenantContactUpdatedComment}}"
  }
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have tenant contact id", function() {
    expect(res.body.id).to.equal(bru.getVar("tenantContactId"));
  });
}
