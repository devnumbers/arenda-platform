meta {
  name: Delete Payment Method
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/subscription/payment-methods/{{paymentMethodId}}
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 204", function() {
    expect(res.status).to.equal(204);
  });
}
