meta {
  name: List Payments
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/subscription/payments
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have items", function() {
    expect(res.body.items).to.be.an("array");
  });
}
