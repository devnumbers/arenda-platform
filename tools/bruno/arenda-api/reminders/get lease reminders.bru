meta {
  name: Get Lease Reminders
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/leases/{{leaseId}}/reminders
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
}
