meta {
  name: Fill Limit 1
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{extraPropertyName1}}",
    "type": "apartment",
    "address": "{{extraPropertyAddress1}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("extraPropertyName1", "E2E Extra Prop 1 " + Date.now());
  bru.setVar("extraPropertyAddress1", "E2E Extra St 1 " + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("extraPropertyId1", res.body.id);
    bru.setVar("extraPropertyId1", res.body.id);
    console.log("saved extraPropertyId1 =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
