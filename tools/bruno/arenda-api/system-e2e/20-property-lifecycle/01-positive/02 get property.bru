meta {
  name: Get Property
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/properties/{{mainPropertyId}}
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("mainPropertyId") || bru.getVar("mainPropertyId"));
  });

  test("should be active and free", function() {
    expect(res.body.status).to.equal("active");
    expect(res.body.occupancy).to.equal("free");
  });
}
