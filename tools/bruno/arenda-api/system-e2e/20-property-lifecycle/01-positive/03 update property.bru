meta {
  name: Update Property
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/properties/{{mainPropertyId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{updatedPropertyName}}",
    "description": "{{updatedPropertyDescription}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("updatedPropertyName", "E2E Main Prop Updated " + Date.now());
  bru.setVar("updatedPropertyDescription", "Updated description " + Date.now());
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("mainPropertyId") || bru.getVar("mainPropertyId"));
  });

  test("should reflect updated description", function() {
    expect(res.body.description).to.include("Updated description");
  });
}
