meta {
  name: List Properties
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/properties
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have items array", function() {
    expect(res.body.items).to.be.an("array");
  });

  test("should include main property", function() {
    const mainId = bru.getEnvVar("mainPropertyId") || bru.getVar("mainPropertyId");
    const ids = res.body.items.map(i => i.id);
    expect(ids).to.include(mainId);
  });
}
