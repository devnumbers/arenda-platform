meta {
  name: Logout
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:post-response {
  bru.setEnvVar("session_id", "");
  bru.setVar("session_id", "");
  bru.setEnvVar("cookieName", "");
  bru.setVar("cookieName", "");
  console.log("cleared session_id and cookieName");
}

tests {
  test("should return 204", function() {
    expect(res.status).to.equal(204);
  });
}
