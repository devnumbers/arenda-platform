meta {
  name: Confirm Nonexistent Payment
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/fake-subscription-payment/{{fakePaymentId}}/confirm
  body: none
  auth: none
}

script:pre-request {
  bru.setVar("fakePaymentId", "11111111-1111-1111-1111-111111111111");
}

tests {
  test("should return 404", function() {
    expect(res.status).to.equal(404);
  });
}
