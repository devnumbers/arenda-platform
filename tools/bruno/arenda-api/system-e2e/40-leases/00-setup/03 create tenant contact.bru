meta {
  name: Create Tenant Contact For Lease
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Анна",
    "surname": "Аннова",
    "patronymic": "Анновна",
    "phone": "{{leaseTenantContactPhone}}",
    "email": "{{leaseTenantContactEmail}}",
    "comment": "{{leaseTenantComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  const suffix = Date.now().toString().slice(-7).padStart(7, "0");
  const phone = `+7916${suffix}`;
  const email = `e2e.lease.tenant.${Date.now()}@example.com`;
  bru.setVar("leaseTenantContactPhone", phone);
  bru.setVar("leaseTenantContactEmail", email);
  bru.setVar("leaseTenantComment", "E2E tenant contact for lease " + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("leaseTenantContactId", res.body.id);
    bru.setVar("leaseTenantContactId", res.body.id);
    console.log("saved leaseTenantContactId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have tenant contact id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should match generated phone and email", function() {
    expect(res.body.phone).to.equal(bru.getVar("leaseTenantContactPhone"));
    expect(res.body.email).to.equal(bru.getVar("leaseTenantContactEmail"));
  });
}
