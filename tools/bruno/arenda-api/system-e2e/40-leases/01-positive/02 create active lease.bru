meta {
  name: Create Active Lease
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/leases
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "property_id": "{{activePropertyId}}",
    "tenant_contact_id": "{{leaseTenantContactId}}",
    "start_date": "{{activeLeaseStart}}",
    "end_date": "{{activeLeaseEnd}}",
    "rent_amount_kopecks": 12000000,
    "deposit_amount_kopecks": 2400000,
    "payment_day": 10,
    "comment": "{{activeLeaseComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("activeLeaseComment", "E2E active lease " + Date.now());

  const today = new Date();
  const start = new Date(today.getFullYear() - 1, today.getMonth(), 1);
  const end = new Date(today.getFullYear() + 1, today.getMonth(), 1);
  bru.setVar("activeLeaseStart", start.toISOString().slice(0, 10));
  bru.setVar("activeLeaseEnd", end.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("activeLeaseId", res.body.id);
    bru.setVar("activeLeaseId", res.body.id);
    console.log("saved activeLeaseId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have lease id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be active", function() {
    expect(res.body.status).to.equal("active");
  });

  test("should reference active property and tenant contact", function() {
    expect(res.body.property_id).to.equal(bru.getEnvVar("activePropertyId") || bru.getVar("activePropertyId"));
    expect(res.body.tenant_contact).to.be.an("object");
    expect(res.body.tenant_contact.id).to.equal(bru.getEnvVar("leaseTenantContactId") || bru.getVar("leaseTenantContactId"));
  });

  test("should match relative active dates", function() {
    expect(res.body.start_date).to.equal(bru.getVar("activeLeaseStart"));
    expect(res.body.end_date).to.equal(bru.getVar("activeLeaseEnd"));
  });
}
