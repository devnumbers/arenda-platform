meta {
  name: Pause Recurring Operation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/recurring-operations/{{recurringOperationId}}/pause
  auth: none
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should be paused", function() {
    expect(res.body.status).to.equal("paused");
  });
}
