meta {
  name: Update Recurring Operation
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/recurring-operations/{{recurringOperationId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "amount_kopecks": {{recurringOperationUpdatedAmountKopecks}},
    "comment": "{{recurringOperationUpdatedComment}}"
  }
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have recurring operation id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("recurringOperationId") || bru.getVar("recurringOperationId"));
  });
}
