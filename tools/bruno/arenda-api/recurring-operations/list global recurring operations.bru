meta {
  name: List Global Recurring Operations
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/recurring-operations?limit=10
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have items array", function() {
    expect(res.body.items).to.be.an("array");
  });

  test("each item should have a status", function() {
    res.body.items.forEach(function(item) {
      expect(item.status).to.exist;
    });
  });
}
