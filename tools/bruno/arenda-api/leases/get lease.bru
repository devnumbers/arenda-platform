meta {
  name: Get Lease
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/leases/{{leaseId}}
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session and a leaseId. Run leases/create first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("leaseId") || bru.getVar("leaseId"));
  });
}
