meta {
  name: Create Lease
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/leases
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "property_id": "{{propertyId}}",
    "tenant_contact_id": "{{tenantContactId}}",
    "start_date": "{{leaseStartDate}}",
    "end_date": "{{leaseEndDate}}",
    "rent_amount_kopecks": {{leaseRentAmountKopecks}},
    "payment_day": {{leasePaymentDay}},
    "deposit_amount_kopecks": {{leaseDepositAmountKopecks}},
    "comment": "{{leaseComment}}"
  }
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  // Save the created lease id for subsequent lease requests.
  if (res.body && res.body.id) {
    bru.setVar("leaseId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have lease id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
