meta {
  name: Complete Lease
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/leases/{{leaseId}}/complete
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session and a leaseId. Run leases/create first.
  const sessionId = bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getVar("leaseId"));
  });
}
