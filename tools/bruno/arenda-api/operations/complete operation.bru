meta {
  name: Complete Operation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/operations/{{operationId}}/complete
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching operation id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("operationId") || bru.getVar("operationId"));
  });

  test("should transition to completed status based on operation type", function() {
    // expense operations become paid; income operations become received.
    const completedStatuses = ["paid", "received"];
    expect(res.body.status).to.be.oneOf(completedStatuses);
  });
}
