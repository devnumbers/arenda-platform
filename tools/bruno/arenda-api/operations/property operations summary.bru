meta {
  name: Property Operations Summary
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/properties/{{propertyId}}/operations/summary
  body: none
  auth: none
}

script:pre-request {
  // Requires an authenticated session. Run auth/verify-code first.
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have monthly profit kopecks", function() {
    expect(res.body.monthly_profit_kopecks).to.exist;
  });

  test("should have all time profit kopecks", function() {
    expect(res.body.all_time_profit_kopecks).to.exist;
  });
}
