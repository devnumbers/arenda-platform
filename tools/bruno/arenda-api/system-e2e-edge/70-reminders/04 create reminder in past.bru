meta {
  name: Create Reminder In Past
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/properties/{{edgeRemindersPropertyId}}/operations/{{edgeFutureOperationId}}/reminders
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "reminder_date": "{{edgePastReminderDate}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const d = new Date();
  d.setDate(d.getDate() - 1);
  bru.setVar("edgePastReminderDate", d.toISOString().slice(0, 10));
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
