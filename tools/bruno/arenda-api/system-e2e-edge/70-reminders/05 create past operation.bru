meta {
  name: Create Past Operation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/properties/{{edgeRemindersPropertyId}}/operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "income",
    "category": "rent",
    "amount_kopecks": 100000,
    "operation_date": "{{edgePastOpDate}}",
    "comment": "Edge past operation"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const d = new Date();
  d.setDate(d.getDate() - 2);
  bru.setVar("edgePastOpDate", d.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgePastOperationId", res.body.id);
    bru.setVar("edgePastOperationId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
