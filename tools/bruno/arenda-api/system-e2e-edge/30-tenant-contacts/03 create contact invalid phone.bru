meta {
  name: Create Contact With Invalid Phone
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Борис",
    "phone": "not-a-phone"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}


tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
