meta {
  name: List Reminders Default Pagination
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/reminders
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return array", function() {
    expect(res.body.items).to.be.an("array");
  });

  test("should include created reminders", function() {
    const items = res.body.items || [];
    const foundMain = items.some(r => r.id === bru.getVar("reminderIdMain"));
    const foundRecurring = items.some(r => r.id === bru.getVar("recurringReminderFirstId"));
    expect(foundMain || foundRecurring).to.equal(true);
  });
}
