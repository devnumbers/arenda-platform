meta {
  name: Get Recurring Operation Reminders
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/properties/{{propertyIdMain}}/recurring-operations/{{recurringOperationIdMain}}/reminders
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should contain created reminders", function() {
    const items = res.body.items || [];
    expect(items.length).to.be.greaterThan(0);
    const found = items.some(r => r.id === bru.getEnvVar("recurringReminderFirstId") || bru.getVar("recurringReminderFirstId"));
    expect(found).to.equal(true);
  });
}
