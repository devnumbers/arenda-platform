meta {
  name: Reminder For Another Users Resource
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/properties/{{propertyIdMain}}/operations/11111111-1111-1111-1111-111111111111/reminders
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "reminder_date": "{{futureDate5}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 404", function() {
    expect(res.status).to.equal(404);
  });
}
