meta {
  name: Update Cancelled Reminder
  type: http
  seq: 34
}

patch {
  url: {{baseUrl}}/reminders/{{reminderIdCancelledTest}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "reminder_date": "{{futureDate15}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 400 or 409", function() {
    expect(res.status).to.be.oneOf([400, 409]);
  });
}
