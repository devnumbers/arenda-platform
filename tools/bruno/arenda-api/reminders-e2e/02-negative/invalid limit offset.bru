meta {
  name: Invalid Limit Offset
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/reminders?limit=abc&offset=def
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
