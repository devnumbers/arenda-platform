meta {
  name: Create Property Lifecycle
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{propertyNameLifecycle}}",
    "type": "{{propertyType}}",
    "address": "{{propertyAddressLifecycle}}",
    "description": "E2E reminders lifecycle property"
  }
}

script:pre-request {
  bru.setVar("propertyNameLifecycle", "E2E Lifecycle " + Date.now());
  bru.setVar("propertyAddressLifecycle", "Lifecycle St " + Date.now());
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("propertyIdLifecycle", res.body.id);
    bru.setVar("propertyIdLifecycle", res.body.id);
    console.log("saved propertyIdLifecycle =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
