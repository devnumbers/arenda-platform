meta {
  name: Create Property Lease Short
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{propertyNameLeaseShort}}",
    "type": "{{propertyType}}",
    "address": "{{propertyAddressLeaseShort}}",
    "description": "E2E reminders lease short property"
  }
}

script:pre-request {
  bru.setVar("propertyNameLeaseShort", "E2E Lease Short " + Date.now());
  bru.setVar("propertyAddressLeaseShort", "Lease Short St " + Date.now());
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("propertyIdLeaseShort", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
