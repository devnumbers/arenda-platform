meta {
  name: Create Property Main
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{propertyNameMain}}",
    "type": "{{propertyType}}",
    "address": "{{propertyAddressMain}}",
    "description": "E2E reminders test property main"
  }
}

script:pre-request {
  function fmtDate(d) {
    return d.toISOString().split('T')[0];
  }
  function addDays(base, days) {
    const d = new Date(base);
    d.setDate(d.getDate() + days);
    return fmtDate(d);
  }
  const today = fmtDate(new Date());
  bru.setVar("todayDate", today);
  bru.setVar("futureDate3", addDays(today, 3));
  bru.setVar("futureDate5", addDays(today, 5));
  bru.setVar("futureDate7", addDays(today, 7));
  bru.setVar("futureDate10", addDays(today, 10));
  bru.setVar("futureDate15", addDays(today, 15));
  bru.setVar("futureDate30", addDays(today, 30));
  bru.setVar("futureDate31", addDays(today, 31));
  bru.setVar("futureDate45", addDays(today, 45));
  bru.setVar("futureDate60", addDays(today, 60));
  bru.setVar("recurringPaymentDay", parseInt(bru.getVar("futureDate3").split('-')[2], 10));
  bru.setVar("pastDate1", addDays(today, -1));
  bru.setVar("pastDate5", addDays(today, -5));
  bru.setVar("pastDate30", addDays(today, -30));
  bru.setVar("pastDate10", addDays(today, -10));
  bru.setVar("tomorrowDate", addDays(today, 1));
  bru.setVar("propertyNameMain", "E2E Reminders Main " + Date.now());
  bru.setVar("propertyAddressMain", "Main St " + Date.now());

  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("propertyIdMain", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
