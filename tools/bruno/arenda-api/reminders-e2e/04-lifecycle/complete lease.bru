meta {
  name: Complete Lease
  type: http
  seq: 58
}

post {
  url: {{baseUrl}}/leases/{{leaseIdComplete}}/complete
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("leaseIdComplete") || bru.getVar("leaseIdComplete"));
  });
}
