meta {
  name: Create Reminder For Recurring Offset Change
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/properties/{{propertyIdMain}}/recurring-operations/{{recurringOperationIdOffset}}/reminders
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "reminder_date": "{{tomorrowDate}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.items && res.body.items.length > 0) {
    bru.setVar("offsetChangeOldReminderId", res.body.items[0].id);
    bru.setVar("offsetChangeOldCount", res.body.items.length);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should return reminders", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.greaterThan(0);
  });
}
