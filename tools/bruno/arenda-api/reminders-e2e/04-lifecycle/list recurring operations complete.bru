meta {
  name: List Recurring Operations Complete
  type: http
  seq: 56
}

get {
  url: {{baseUrl}}/properties/{{propertyIdComplete}}/recurring-operations
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.items && res.body.items.length > 0) {
    bru.setEnvVar("recurringOperationIdComplete", res.body.items[0].id);
    bru.setVar("recurringOperationIdComplete", res.body.items[0].id);
    console.log("saved recurringOperationIdComplete =", res.body.items[0].id);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should contain recurring operation", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.greaterThan(0);
  });
}
