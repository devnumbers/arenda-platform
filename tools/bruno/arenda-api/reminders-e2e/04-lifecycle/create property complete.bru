meta {
  name: Create Property Complete
  type: http
  seq: 54
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{propertyNameComplete}}",
    "type": "{{propertyType}}",
    "address": "{{propertyAddressComplete}}",
    "description": "E2E reminders complete property"
  }
}

script:pre-request {
  bru.setVar("propertyNameComplete", "E2E Complete " + Date.now());
  bru.setVar("propertyAddressComplete", "Complete St " + Date.now());
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("propertyIdComplete", res.body.id);
    bru.setVar("propertyIdComplete", res.body.id);
    console.log("saved propertyIdComplete =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
