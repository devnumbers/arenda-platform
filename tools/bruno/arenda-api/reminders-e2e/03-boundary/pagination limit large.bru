meta {
  name: Pagination Limit Large
  type: http
  seq: 41
}

get {
  url: {{baseUrl}}/reminders?limit=1000&offset=0
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return array", function() {
    expect(res.body.items).to.be.an("array");
  });
}
