meta {
  name: Pagination Offset Beyond Count
  type: http
  seq: 42
}

get {
  url: {{baseUrl}}/reminders?limit=10&offset=100000
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return empty array", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.equal(0);
  });
}
