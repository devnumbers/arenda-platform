meta {
  name: Get Subscription After Downgrade
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/subscription
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  console.log("subscription status =", res.body.status);
  console.log("current tariff =", res.body.tariff && res.body.tariff.name);
  console.log("pending tariff =", res.body.pendingTariff && res.body.pendingTariff.name);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should still be active", function() {
    expect(res.body.status).to.equal("active");
  });

  test("should have pending basic tariff", function() {
    expect(res.body.pendingTariff).to.be.an("object");
    expect(res.body.pendingTariff.name).to.equal("basic");
  });

  test("should have pending change date", function() {
    expect(res.body.pendingChangeAt).to.be.a("string");
  });

  test("should have second method active", function() {
    expect(res.body.activePaymentMethod).to.be.an("object");
    expect(res.body.activePaymentMethod.id).to.equal(bru.getVar("secondPaymentMethodId"));
  });
}
