meta {
  name: Get Subscription
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/subscription
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  console.log("subscription status =", res.body.status);
  console.log("subscription tariff =", res.body.tariff && res.body.tariff.name);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should be active", function() {
    expect(res.body.status).to.equal("active");
  });

  test("should be on pro tariff", function() {
    expect(res.body.tariff.name).to.equal("pro");
  });

  test("should have auto renew enabled", function() {
    expect(res.body.autoRenewEnabled).to.equal(true);
  });

  test("should have an active payment method", function() {
    expect(res.body.activePaymentMethod).to.be.an("object");
    expect(res.body.activePaymentMethod.id).to.be.a("string");
  });
}
