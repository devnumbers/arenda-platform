meta {
  name: List Payments
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/subscription/payments
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  console.log("payments count =", res.body.items && res.body.items.length);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return at least one payment", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.at.least(1);
  });

  test("should include succeeded pro payment", function() {
    const payment = res.body.items.find(i => i.tariff.name === "pro");
    expect(payment).to.be.an("object");
    expect(payment.status).to.equal("succeeded");
    expect(payment.amountKopecks).to.be.greaterThan(0);
  });
}
