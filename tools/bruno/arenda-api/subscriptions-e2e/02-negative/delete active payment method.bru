meta {
  name: Delete Active Payment Method
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/subscription/payment-methods/{{secondPaymentMethodId}}
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 409", function() {
    expect(res.status).to.equal(409);
  });
}
