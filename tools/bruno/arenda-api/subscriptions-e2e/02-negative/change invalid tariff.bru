meta {
  name: Change Invalid Tariff
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/subscription/change
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "tariffName": "basic",
    "period": "day"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
