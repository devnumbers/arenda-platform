meta {
  name: Get Subscription Recovered
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/subscription
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  console.log("recovered subscription status =", res.body.status);
  console.log("recovered subscription tariff =", res.body.tariff && res.body.tariff.name);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should be active", function() {
    expect(res.body.status).to.equal("active");
  });

  test("should be on business tariff", function() {
    expect(res.body.tariff.name).to.equal("business");
  });
}
