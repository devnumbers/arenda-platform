meta {
  name: Change Tariff Pro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/subscription/change
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "tariffName": "pro",
    "period": "month"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.paymentId) {
    bru.setVar("upgradePaymentId", res.body.paymentId);
    console.log("saved upgradePaymentId =", res.body.paymentId);
  }
  if (res.body && res.body.confirmUrl) {
    bru.setVar("upgradeConfirmUrl", res.body.confirmUrl);
    console.log("saved upgradeConfirmUrl =", res.body.confirmUrl);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return payment id", function() {
    expect(res.body.paymentId).to.be.a("string");
  });

  test("should return confirm url", function() {
    expect(res.body.confirmUrl).to.be.a("string");
  });
}
