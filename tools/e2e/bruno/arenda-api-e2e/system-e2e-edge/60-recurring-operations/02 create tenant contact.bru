meta {
  name: Create Tenant Contact
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Олег",
    "surname": "Олегов",
    "patronymic": "Олегович",
    "phone": "{{edgeTenantPhone}}",
    "email": "{{edgeTenantEmail}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const suffix = Date.now().toString().slice(-7).padStart(7, "0");
  bru.setVar("edgeTenantPhone", `+7919${suffix}`);
  bru.setVar("edgeTenantEmail", `edge.recurring.${Date.now()}@example.com`);
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeRecurringTenantId", res.body.id);
    bru.setVar("edgeRecurringTenantId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
