meta {
  name: Create Recurring Op Payment Day 31
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/properties/{{edgeRecurringPropertyId}}/recurring-operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "expense",
    "category": "utilities",
    "amount_kopecks": 10000,
    "start_date": "{{edgePaymentDay31Start}}",
    "payment_day": 31,
    "end_date": "{{edgePaymentDay31End}}",
    "comment": "Edge payment day 31"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const today = new Date();
  bru.setVar("edgePaymentDay31Start", `${today.getFullYear() - 1}-05-01`);
  const end = new Date();
  end.setFullYear(end.getFullYear() + 1);
  bru.setVar("edgePaymentDay31End", end.toISOString().slice(0, 10));
}

tests {
  test("should return 201 or 400 depending on validation", function() {
    expect(res.status).to.be.oneOf([201, 400]);
  });
}
