meta {
  name: Create Recurring Op Payment Day Zero
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/properties/{{edgeRecurringPropertyId}}/recurring-operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "expense",
    "category": "utilities",
    "amount_kopecks": 10000,
    "start_date": "{{edgeRecurringStart}}",
    "payment_day": 0,
    "end_date": "{{edgeRecurringEnd}}",
    "comment": "Edge payment day zero"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const today = new Date();
  bru.setVar("edgeRecurringStart", today.toISOString().slice(0, 10));
  const end = new Date();
  end.setFullYear(end.getFullYear() + 1);
  bru.setVar("edgeRecurringEnd", end.toISOString().slice(0, 10));
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
