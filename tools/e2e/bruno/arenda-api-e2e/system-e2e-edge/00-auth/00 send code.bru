meta {
  name: Send Email Code
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/email/send
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{phone}}",
    "email": "{{email}}"
  }
}

script:pre-request {
  // When the runner provides a pre-extracted code (skipSend=true), avoid sending
  // a new code so the provided code stays valid for verification.
  const skipSend = bru.getEnvVar("skipSend") === "true";
  if (skipSend) {
    req.setMethod("GET");
    req.setUrl(bru.getEnvVar("baseUrl") + "/tariffs");
  }
}

tests {
  test("should return 200 or 429 on rerun", function() {
    const skipSend = bru.getEnvVar("skipSend") === "true";
    if (skipSend) {
      expect(res.status).to.be.oneOf([200, 401]);
    } else {
      expect(res.status).to.be.oneOf([200, 429]);
      if (res.status === 200) {
        expect(res.body.retryAfter).to.equal(60);
      }
    }
  });
}
