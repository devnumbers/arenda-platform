meta {
  name: Verify With Wrong Code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/email/verify
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{phone}}",
    "email": "{{email}}",
    "code": "000000"
  }
}

tests {
  test("should return 400 or 401", function() {
    expect(res.status).to.be.oneOf([400, 401]);
  });
}
