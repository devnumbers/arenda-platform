meta {
  name: Verify With Expired Code
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/email/verify
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{phone}}",
    "email": "{{email}}",
    "code": "000001"
  }
}

tests {
  test("should return 400 or 401 for any non-current code", function() {
    expect(res.status).to.be.oneOf([400, 401]);
  });
}
