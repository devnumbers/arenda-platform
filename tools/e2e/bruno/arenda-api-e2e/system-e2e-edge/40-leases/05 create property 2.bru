meta {
  name: Create Property 2
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{edgeProp2Name}}",
    "type": "apartment",
    "address": "{{edgeProp2Address}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  bru.setVar("edgeProp2Name", "Edge Lease Prop 2 " + Date.now());
  bru.setVar("edgeProp2Address", "Edge Lease St 2 " + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeProp2Id", res.body.id);
    bru.setVar("edgeProp2Id", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
