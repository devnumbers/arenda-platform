meta {
  name: Create Future Lease A
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/leases
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "property_id": "{{edgeProp4Id}}",
    "tenant_contact_id": "{{edgeTenantContactId}}",
    "start_date": "{{edgeFutureAStart}}",
    "end_date": "{{edgeFutureAEnd}}",
    "rent_amount_kopecks": 10000000,
    "deposit_amount_kopecks": 2000000,
    "payment_day": 15,
    "comment": "Edge future lease A"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const today = new Date();
  const start = new Date(today.getFullYear() + 2, today.getMonth(), 1);
  const end = new Date(today.getFullYear() + 3, today.getMonth(), 1);
  bru.setVar("edgeFutureAStart", start.toISOString().slice(0, 10));
  bru.setVar("edgeFutureAEnd", end.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeFutureLeaseAId", res.body.id);
    bru.setVar("edgeFutureLeaseAId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
