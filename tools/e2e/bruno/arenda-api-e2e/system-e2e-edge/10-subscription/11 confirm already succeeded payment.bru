meta {
  name: Confirm Already Succeeded Payment
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/internal/fake-subscription-payment/{{edgePaymentId}}/confirm
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}


tests {
  test("should return 404 or 409", function() {
    expect(res.status).to.be.oneOf([404, 409]);
  });
}
