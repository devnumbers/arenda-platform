meta {
  name: Create Property A
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{edgePropAName}}",
    "type": "apartment",
    "address": "{{edgePropAAddress}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  bru.setVar("edgePropAName", "Edge Prop A " + Date.now());
  bru.setVar("edgePropAAddress", "Edge St A " + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgePropAId", res.body.id);
    bru.setVar("edgePropAId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
