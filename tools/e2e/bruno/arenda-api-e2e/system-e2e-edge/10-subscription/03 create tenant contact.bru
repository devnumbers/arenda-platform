meta {
  name: Create Tenant Contact
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Елена",
    "surname": "Еленова",
    "patronymic": "Еленовна",
    "phone": "{{edgeTenantPhone}}",
    "email": "{{edgeTenantEmail}}",
    "comment": "Edge subscription tenant"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const suffix = Date.now().toString().slice(-7).padStart(7, "0");
  bru.setVar("edgeTenantPhone", `+7915${suffix}`);
  bru.setVar("edgeTenantEmail", `edge.tenant.${Date.now()}@example.com`);
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeTenantContactId", res.body.id);
    bru.setVar("edgeTenantContactId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
