meta {
  name: Create Property With Long Name
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{edgeLongName}}",
    "type": "apartment",
    "address": "{{edgeLongAddress}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  bru.setVar("edgeLongName", "A".repeat(260));
  bru.setVar("edgeLongAddress", "Long Address " + Date.now());
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
