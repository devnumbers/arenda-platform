meta {
  name: Create Contact A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Анна",
    "surname": "Аннова",
    "patronymic": "Анновна",
    "phone": "{{edgeContactAPhone}}",
    "email": "{{edgeContactAEmail}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const suffix = Date.now().toString().slice(-7).padStart(7, "0");
  bru.setVar("edgeContactAPhone", `+7917${suffix}`);
  bru.setVar("edgeContactAEmail", `edge.contact.A.${Date.now()}@example.com`);
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeContactAId", res.body.id);
    bru.setVar("edgeContactAId", res.body.id);
    bru.setEnvVar("edgeContactAStoredPhone", res.body.phone);
    bru.setVar("edgeContactAStoredPhone", res.body.phone);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
