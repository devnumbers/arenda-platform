meta {
  name: Create Contact B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tenant-contacts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Анна",
    "surname": "Аннова",
    "patronymic": "Анновна",
    "phone": "{{edgeContactBPhone}}",
    "email": "{{edgeContactBEmail}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  const suffix = Date.now().toString().slice(-7).padStart(7, "0");
  bru.setVar("edgeContactBPhone", `+7917${suffix}`);
  bru.setVar("edgeContactBEmail", `edge.contact.B.${Date.now()}@example.com`);
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeContactBId", res.body.id);
    bru.setVar("edgeContactBId", res.body.id);
    bru.setEnvVar("edgeContactBStoredPhone", res.body.phone);
    bru.setVar("edgeContactBStoredPhone", res.body.phone);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
