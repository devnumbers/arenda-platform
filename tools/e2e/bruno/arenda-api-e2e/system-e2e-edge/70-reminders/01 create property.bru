meta {
  name: Create Property
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{edgePropName}}",
    "type": "apartment",
    "address": "{{edgePropAddress}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:pre-request {
  bru.setVar("edgePropName", "Edge Reminders Prop " + Date.now());
  bru.setVar("edgePropAddress", "Edge Reminders St " + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("edgeRemindersPropertyId", res.body.id);
    bru.setVar("edgeRemindersPropertyId", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
}
