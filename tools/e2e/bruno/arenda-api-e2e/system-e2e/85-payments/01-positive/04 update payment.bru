meta {
  name: Update Payment
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/properties/{{propertyId}}/payments/{{paymentId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "E2E аренда обновлённая",
    "amountKopecks": 6000000,
    "recurrence": {"kind": "weekly", "weekdays": [1]},
    "endDate": null
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should apply the diff and clear endDate", function() {
    expect(res.body.title).to.equal("E2E аренда обновлённая");
    expect(res.body.amountKopecks).to.equal(6000000);
    expect(res.body.recurrence.kind).to.equal("weekly");
    expect(res.body.endDate).to.be.null;
  });
}
