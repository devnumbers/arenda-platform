meta {
  name: Pause Payment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/properties/{{propertyId}}/payments/{{paymentId}}/pause
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should open an endless pause interval", function() {
    const active = (res.body.pauses || []).find(p => p.toDate === null);
    expect(active).to.be.an("object");
  });
}
