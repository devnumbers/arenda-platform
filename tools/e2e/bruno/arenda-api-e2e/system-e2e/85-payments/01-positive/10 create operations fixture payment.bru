meta {
  name: Create Operations Fixture Payment
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/properties/{{propertyId}}/payments
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "expense",
    "title": "E2E операции и избранное",
    "amountKopecks": 90000,
    "recurrence": {"kind": "daily"},
    "paymentForm": "cash",
    "categorySlug": "utilities",
    "autoPay": false
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("opsPaymentId", res.body.id);
    bru.setVar("opsPaymentId", res.body.id);
    console.log("saved opsPaymentId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should start unfavorite", function() {
    expect(res.body.isFavorite).to.equal(false);
  });
}
