meta {
  name: Resume Payment Twice
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/properties/{{propertyId}}/payments/{{paymentId}}/resume
  body: none
  auth: none
}

script:pre-request {
  // 07 resumed the payment just before: resuming without an active pause is
  // the 409 of "возобновление без активной".
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 409 on the resume without an active pause", function() {
    expect(res.status).to.equal(409);
  });
}
