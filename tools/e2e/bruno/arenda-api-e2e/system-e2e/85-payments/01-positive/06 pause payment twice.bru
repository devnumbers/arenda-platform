meta {
  name: Pause Payment Twice
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/properties/{{propertyId}}/payments/{{paymentId}}/pause
  body: none
  auth: none
}

script:pre-request {
  // 05 paused the payment just before: the repeated pause is the 409 of
  // "повторная пауза".
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 409 on the repeated pause", function() {
    expect(res.status).to.equal(409);
  });
}
