meta {
  name: Create Expense Operation
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/properties/{{operationsPropertyId}}/operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "expense",
    "category": "utilities",
    "amount_kopecks": 50000,
    "operation_date": "{{expenseOpDate}}",
    "comment": "{{expenseOperationComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("expenseOperationComment", "E2E expense operation " + Date.now());

  const d = new Date();
  bru.setVar("expenseOpDate", d.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("expenseOperationId", res.body.id);
    bru.setVar("expenseOperationId", res.body.id);
    console.log("saved expenseOperationId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have operation id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be expense utilities", function() {
    expect(res.body.type).to.equal("expense");
    expect(res.body.category).to.equal("utilities");
  });

  test("should match amount and date", function() {
    expect(res.body.amount_kopecks).to.equal(50000);
    expect(res.body.operation_date).to.equal(bru.getVar("expenseOpDate"));
  });
}
