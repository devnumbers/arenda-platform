meta {
  name: Update Operation
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/operations/{{incomeOperationId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "amount_kopecks": 200000,
    "operation_date": "{{updatedOpDate}}",
    "comment": "{{updatedOperationComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("updatedOperationComment", "E2E updated operation " + Date.now());

  const d = new Date();
  d.setDate(d.getDate() + 5);
  bru.setVar("updatedOpDate", d.toISOString().slice(0, 10));
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("incomeOperationId") || bru.getVar("incomeOperationId"));
  });

  test("should reflect updated amount, date and comment", function() {
    expect(res.body.amount_kopecks).to.equal(200000);
    expect(res.body.operation_date).to.equal(bru.getVar("updatedOpDate"));
    expect(res.body.comment).to.include("E2E updated operation");
  });
}
