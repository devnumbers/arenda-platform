meta {
  name: List Operations
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/operations?limit=10
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have items array", function() {
    expect(res.body.items).to.be.an("array");
  });

  test("should contain previously created operations", function() {
    const ids = res.body.items.map(function(item) { return item.id; });
    const incomeOperationId = bru.getEnvVar("incomeOperationId") || bru.getVar("incomeOperationId");
    const expenseOperationId = bru.getEnvVar("expenseOperationId") || bru.getVar("expenseOperationId");
    if (incomeOperationId) {
      expect(ids).to.include(incomeOperationId);
    }
    if (expenseOperationId) {
      expect(ids).to.include(expenseOperationId);
    }
  });
}
