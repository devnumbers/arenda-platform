meta {
  name: Complete Operation
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/operations/{{expenseOperationId}}/complete
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  const expenseOperationId = bru.getEnvVar("expenseOperationId") || bru.getVar("expenseOperationId");
  bru.setVar("expenseOperationId", expenseOperationId);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching operation id", function() {
    expect(res.body.id).to.equal(bru.getVar("expenseOperationId"));
  });

  test("should transition to paid status", function() {
    expect(res.body.status).to.equal("paid");
  });
}
