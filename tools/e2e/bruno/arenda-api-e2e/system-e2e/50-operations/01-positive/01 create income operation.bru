meta {
  name: Create Income Operation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties/{{operationsPropertyId}}/operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "income",
    "category": "rent",
    "name": "{{incomeOperationName}}",
    "amount_kopecks": 150000,
    "operation_date": "{{incomeOpDate}}",
    "comment": "{{incomeOperationComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("incomeOperationName", "E2E income operation " + Date.now());
  bru.setVar("incomeOperationComment", "E2E income operation " + Date.now());

  const d = new Date();
  d.setDate(d.getDate() + 1);
  bru.setVar("incomeOpDate", d.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("incomeOperationId", res.body.id);
    bru.setVar("incomeOperationId", res.body.id);
    console.log("saved incomeOperationId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have operation id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be income rent", function() {
    expect(res.body.type).to.equal("income");
    expect(res.body.category).to.equal("rent");
  });

  test("should match amount and date", function() {
    expect(res.body.amount_kopecks).to.equal(150000);
    expect(res.body.operation_date).to.equal(bru.getVar("incomeOpDate"));
  });
}
