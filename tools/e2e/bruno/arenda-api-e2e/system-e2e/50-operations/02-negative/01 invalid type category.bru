meta {
  name: Invalid Type Category Operation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties/{{operationsPropertyId}}/operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "income",
    "category": "utilities",
    "amount_kopecks": 100000,
    "operation_date": "{{operationDate}}",
    "comment": "{{invalidTypeCategoryComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("invalidTypeCategoryComment", "E2E invalid type category " + Date.now());

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  bru.setVar("operationDate", tomorrow.toISOString().split("T")[0]);
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
