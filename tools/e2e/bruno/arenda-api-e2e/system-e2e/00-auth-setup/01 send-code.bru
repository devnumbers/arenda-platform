meta {
  name: Send Email Code
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/send
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "phone": "{{phone}}",
    "email": "{{email}}"
  }
}

script:pre-request {
  const skipSend = bru.getEnvVar("skipSend") === "true";
  console.log("skipSend =", skipSend);
}

tests {
  const skipSend = bru.getEnvVar("skipSend") === "true";
  test("should return expected status", function() {
    if (skipSend) {
      expect([200, 429]).to.include(res.status);
    } else {
      expect(res.status).to.equal(200);
      expect(res.body.retryAfter).to.equal(60);
    }
  });
}
