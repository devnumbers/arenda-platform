meta {
  name: Confirm Fake Payment
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/internal/fake-subscription-payment/{{paymentId}}/confirm
  body: none
  auth: none
}

script:post-response {
  console.log("fake payment confirmation status =", res.status);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return ok status", function() {
    expect(res.body.status).to.equal("ok");
  });
}
