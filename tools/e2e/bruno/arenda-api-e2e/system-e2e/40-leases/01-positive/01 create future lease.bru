meta {
  name: Create Future Lease
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/leases
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "property_id": "{{futurePropertyId}}",
    "tenant_contact_id": "{{leaseTenantContactId}}",
    "start_date": "{{futureLeaseStart}}",
    "end_date": "{{futureLeaseEnd}}",
    "rent_amount_kopecks": 15000000,
    "deposit_amount_kopecks": 3000000,
    "payment_day": 5,
    "comment": "{{futureLeaseComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("futureLeaseComment", "E2E future lease " + Date.now());

  const today = new Date();
  const start = new Date(today.getFullYear() + 1, today.getMonth(), 1);
  const end = new Date(today.getFullYear() + 2, today.getMonth(), 1);
  bru.setVar("futureLeaseStart", start.toISOString().slice(0, 10));
  bru.setVar("futureLeaseEnd", end.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("futureLeaseId", res.body.id);
    bru.setVar("futureLeaseId", res.body.id);
    console.log("saved futureLeaseId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have lease id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be awaiting start", function() {
    expect(res.body.status).to.equal("awaiting_start");
  });

  test("should reference future property and tenant contact", function() {
    expect(res.body.property_id).to.equal(bru.getEnvVar("futurePropertyId") || bru.getVar("futurePropertyId"));
    expect(res.body.tenant_contact).to.be.an("object");
    expect(res.body.tenant_contact.id).to.equal(bru.getEnvVar("leaseTenantContactId") || bru.getVar("leaseTenantContactId"));
  });

  test("should match relative future dates", function() {
    expect(res.body.start_date).to.equal(bru.getVar("futureLeaseStart"));
    expect(res.body.end_date).to.equal(bru.getVar("futureLeaseEnd"));
  });
}
