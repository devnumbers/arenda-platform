meta {
  name: Get Lease
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/leases/{{leaseId}}
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  const activeLeaseId = bru.getEnvVar("activeLeaseId") || bru.getVar("activeLeaseId");
  const futureLeaseId = bru.getEnvVar("futureLeaseId") || bru.getVar("futureLeaseId");
  bru.setVar("leaseId", activeLeaseId || futureLeaseId);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getVar("leaseId"));
  });
}
