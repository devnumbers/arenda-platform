meta {
  name: Update Lease End Date
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/leases/{{activeLeaseId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "end_date": "{{updatedLeaseEnd}}",
    "comment": "{{updatedLeaseComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("updatedLeaseComment", "E2E updated lease end date " + Date.now());

  const today = new Date();
  const end = new Date(today.getFullYear() + 2, today.getMonth(), 15);
  bru.setVar("updatedLeaseEnd", end.toISOString().slice(0, 10));
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have matching id", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("activeLeaseId") || bru.getVar("activeLeaseId"));
  });

  test("should reflect updated end date", function() {
    expect(res.body.end_date).to.equal(bru.getVar("updatedLeaseEnd"));
  });
}
