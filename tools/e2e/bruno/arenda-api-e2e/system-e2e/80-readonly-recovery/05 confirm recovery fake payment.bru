meta {
  name: Confirm Recovery Fake Payment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/internal/fake-subscription-payment/{{recoveryPaymentId}}/confirm
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }
}

script:post-response {
  console.log("recovery fake payment confirmation status =", res.status);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return ok status", function() {
    expect(res.body.status).to.equal("ok");
  });
}
