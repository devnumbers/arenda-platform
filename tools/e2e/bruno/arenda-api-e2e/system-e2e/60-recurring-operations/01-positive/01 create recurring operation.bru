meta {
  name: Create Recurring Operation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties/{{recurringPropertyId}}/recurring-operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "expense",
    "name": "{{recurringOperationName}}",
    "category": "utilities",
    "amount_kopecks": 50000,
    "start_date": "{{recurringStartDate}}",
    "payment_day": 5,
    "end_date": "{{recurringEndDate}}",
    "comment": "{{recurringComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("recurringOperationName", "E2E recurring utilities " + Date.now());
  bru.setVar("recurringComment", "E2E recurring utilities " + Date.now());

  const today = new Date();
  bru.setVar("recurringStartDate", today.toISOString().slice(0, 10));

  const end = new Date();
  end.setFullYear(end.getFullYear() + 1);
  bru.setVar("recurringEndDate", end.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("recurringOpId", res.body.id);
    bru.setVar("recurringOpId", res.body.id);
    console.log("saved recurringOpId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have recurring operation id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be active", function() {
    expect(res.body.status).to.equal("active");
  });

  test("should match recurring operation data", function() {
    expect(res.body.type).to.equal("expense");
    expect(res.body.category).to.equal("utilities");
    expect(res.body.amount_kopecks).to.equal(50000);
    expect(res.body.payment_day).to.equal(5);
  });

  test("should be monthly", function() {
    expect(res.body.periodicity).to.equal("monthly");
  });
}
