meta {
  name: Verify Operation Reminder Rescheduled
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/properties/{{propertyIdMain}}/operations/{{operationIdMain}}/reminders
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have a pending reminder", function() {
    const items = res.body.items || [];
    const pending = items.filter(r => r.status === "pending");
    expect(pending.length).to.be.greaterThan(0);
  });

  test("reminder should be operation_due", function() {
    const items = res.body.items || [];
    const found = items.some(r => r.event_type === "operation_due");
    expect(found).to.equal(true);
  });
}
