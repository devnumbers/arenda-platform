meta {
  name: Archive Property Lifecycle
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/properties/{{propertyIdLifecycle}}/archive
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
}
