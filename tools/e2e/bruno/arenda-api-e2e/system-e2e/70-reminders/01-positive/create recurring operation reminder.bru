meta {
  name: Create Recurring Operation Reminder
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/properties/{{propertyIdMain}}/recurring-operations/{{recurringOperationIdMain}}/reminders
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "reminder_date": "{{futureDate3}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.items && res.body.items.length > 0) {
    bru.setEnvVar("recurringReminderFirstId", res.body.items[0].id);
    bru.setVar("recurringReminderFirstId", res.body.items[0].id);
    console.log("saved recurringReminderFirstId =", res.body.items[0].id);
    bru.setVar("recurringReminderCount", res.body.items.length);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should return array of reminders", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.greaterThan(0);
  });

  test("should have reminder ids", function() {
    for (const item of res.body.items) {
      expect(item.id).to.be.a("string");
      expect(item.status).to.equal("pending");
      expect(item.target_type).to.equal("operation");
      expect(item.recurring_operation_id).to.be.a("string");
    }
  });
}
