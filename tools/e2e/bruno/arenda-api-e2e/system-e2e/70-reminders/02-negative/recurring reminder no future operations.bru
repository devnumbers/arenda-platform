meta {
  name: Recurring Reminder No Future Operations
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/properties/{{propertyIdMain}}/recurring-operations/{{recurringOperationIdNoFuture}}/reminders
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "reminder_date": "{{futureDate5}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });
}
