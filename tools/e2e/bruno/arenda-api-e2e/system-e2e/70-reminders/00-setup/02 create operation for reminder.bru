meta {
  name: Create Operation For Reminder
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/properties/{{reminderPropertyId}}/operations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{operationName}}",
    "type": "income",
    "category": "rent",
    "amount_kopecks": 100000,
    "operation_date": "{{reminderOpDate}}",
    "comment": "{{reminderOperationComment}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("reminderOperationComment", "E2E operation for reminder " + Date.now());

  const today = new Date();
  bru.setVar("reminderOpDate", today.toISOString().slice(0, 10));
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("reminderOperationId", res.body.id);
    bru.setVar("reminderOperationId", res.body.id);
    console.log("saved reminderOperationId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have operation id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be income rent", function() {
    expect(res.body.type).to.equal("income");
    expect(res.body.category).to.equal("rent");
  });
}
