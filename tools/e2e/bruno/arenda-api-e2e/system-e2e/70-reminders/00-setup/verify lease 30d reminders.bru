meta {
  name: Verify Lease 30d Reminders
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/leases/{{leaseId30}}/reminders
  body: none
  auth: none
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.items) {
    const expiring = res.body.items.find(r => r.event_type === "lease_expiring");
    const requiresAction = res.body.items.find(r => r.event_type === "lease_requires_action");
    if (expiring) {
      bru.setEnvVar("leaseExpiring30Id", expiring.id);
      bru.setVar("leaseExpiring30Id", expiring.id);
      console.log("saved leaseExpiring30Id =", expiring.id);
    }
    if (requiresAction) {
      bru.setEnvVar("leaseRequiresAction30Id", requiresAction.id);
      bru.setVar("leaseRequiresAction30Id", requiresAction.id);
      console.log("saved leaseRequiresAction30Id =", requiresAction.id);
    }
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should contain lease_expiring reminder", function() {
    const items = res.body.items || [];
    const found = items.some(r => r.event_type === "lease_expiring");
    expect(found).to.equal(true);
  });

  test("should contain requires_action reminder", function() {
    const items = res.body.items || [];
    const found = items.some(r => r.event_type === "lease_requires_action");
    expect(found).to.equal(true);
  });
}
