meta {
  name: Create Lease Past
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/leases
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "property_id": "{{propertyIdLeasePast}}",
    "tenant_contact_id": "{{tenantContactId}}",
    "start_date": "{{pastDate30}}",
    "end_date": "{{pastDate5}}",
    "rent_amount_kopecks": {{leaseRentAmountKopecks}},
    "payment_day": 1,
    "deposit_amount_kopecks": {{leaseDepositAmountKopecks}},
    "comment": "E2E lease past"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  if (sessionId) {
    req.setHeader("Cookie", `session_id=${sessionId}`);
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("leaseIdPast", res.body.id);
    bru.setVar("leaseIdPast", res.body.id);
    console.log("saved leaseIdPast =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have lease id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
