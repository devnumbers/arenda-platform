meta {
  name: Create Property For Reminders
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/properties
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "{{reminderPropertyName}}",
    "type": "apartment",
    "address": "{{reminderPropertyAddress}}"
  }
}

script:pre-request {
  const sessionId = bru.getEnvVar("session_id") || bru.getVar("session_id");
  const cookieName = bru.getEnvVar("cookieName") || bru.getVar("cookieName") || "session_id";
  if (sessionId) {
    req.setHeader("Cookie", `${cookieName}=${sessionId}`);
  }

  bru.setVar("reminderPropertyName", "E2E Reminders Prop " + Date.now());
  bru.setVar("reminderPropertyAddress", "E2E Reminders St " + Date.now());

  // Defaults for operation/recurring-operation fixtures in this folder.
  bru.setVar("operationType", "income");
  bru.setVar("operationCategory", "rent");
  bru.setVar("operationAmountKopecks", 100000);
  bru.setVar("recurringOperationType", "income");
  bru.setVar("recurringOperationCategory", "rent");
  bru.setVar("recurringOperationAmountKopecks", 100000);
  bru.setVar("operationName", "E2E operation " + Date.now());
  bru.setVar("recurringOperationName", "E2E recurring operation " + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("reminderPropertyId", res.body.id);
    bru.setVar("reminderPropertyId", res.body.id);
    console.log("saved reminderPropertyId =", res.body.id);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should have property id", function() {
    expect(res.body.id).to.be.a("string");
  });

  test("should be active and free", function() {
    expect(res.body.status).to.equal("active");
    expect(res.body.occupancy).to.equal("free");
  });
}
