# Backend URL used by the frontend middleware and API proxy to reach the API.
BACKEND_URL=http://localhost:8080

APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_SUCCESSFUL_REQUESTS=true

# Comma-separated list of trusted proxy CIDRs. Used to extract the real client
# IP from X-Forwarded-For / X-Real-IP headers.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

POSTGRES_PORT=5433
POSTGRES_USER=arenda
POSTGRES_PASSWORD=arenda
POSTGRES_DB=arenda
DATABASE_URL=postgres://arenda:arenda@localhost:5433/arenda?sslmode=disable
MIGRATIONS_DIR=apps/backend/db/migrations

# PostgreSQL connection pool defaults (all optional).
# DB_MAX_CONNS=64
# DB_MIN_CONNS=16
# DB_MAX_CONN_LIFETIME=30m
# DB_MAX_CONN_IDLE_TIME=5m
# DB_STATEMENT_TIMEOUT=30s
# DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=60s
# DB_HEALTH_CHECK_PERIOD=30s

# Cookie security: defaults to false for local, true for dev/staging/production.
# Setting COOKIE_SECURE=false explicitly is rejected for non-local environments.
COOKIE_SECURE=false

# Email sender: fake (local/dev only) or smtp
EMAIL_SENDER=fake
# Email templates directory. Must be an absolute path when EMAIL_SENDER=smtp in non-local/dev environments.
# EMAIL_TEMPLATES_DIR=apps/backend/templates/email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Arenda Platform
# SMTP_TIMEOUT=10s

# Payment provider adapter: fake (local dev) or tkassa
PAYMENT_PROVIDER=fake
APP_BASE_URL=http://localhost:8080

# T-Kassa configuration (required when PAYMENT_PROVIDER=tkassa).
# APP_BASE_URL must be reachable from the internet for webhooks.
# T_KASSA_BASE_URL has no default in any environment — the test URL is never
# implicit (issue #248): set it explicitly, e.g. the sandbox URL below.
# T_KASSA_TERMINAL_KEY=...
# T_KASSA_PASSWORD=...
# T_KASSA_BASE_URL=https://rest-api-test.tinkoff.ru/v2/
# T_KASSA_TIMEOUT=30s
# T_KASSA_MAX_RETRIES=3            # number of retry attempts after the first request (0 disables retries)
# T_KASSA_RETRY_BASE_DELAY=500ms   # initial exponential backoff delay between retries
# T_KASSA_RETRY_MAX_DELAY=5s       # upper cap for the backoff delay

# Tariff cache TTL; defaults to 5m.
TARIFF_CACHE_TTL=5m

# Operation overdue worker interval; defaults to 24h.
OVERDUE_OPERATION_WORKER_INTERVAL=24h

# Payment reconciliation worker interval; defaults to 5m.
PAYMENT_RECONCILIATION_WORKER_INTERVAL=5m

# Identity data cleaner: how often to purge expired sessions/codes/attempts; defaults to 1h.
IDENTITY_CLEANER_INTERVAL=1h
# Identity data cleaner: rows older than this retention are purged; defaults to 168h (7d).
IDENTITY_CLEANER_RETENTION=168h

# AES-256-GCM encryption key for sensitive data at rest (e.g. provider tokens).
# Hex (64 chars) or base64.
ENCRYPTION_KEY=...

# OpenTelemetry. Set OTEL_TRACES_EXPORTER=otlp to enable traces (use "none" to disable);
# same for OTEL_METRICS_EXPORTER. OTEL_EXPORTER_OTLP_ENDPOINT is required when an exporter is "otlp".
# OTEL_TRACES_SAMPLER_ARG is the TraceIDRatioBased ratio in [0,1] (e.g. 1.0 = sample everything).
OTEL_SERVICE_NAME=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=

# DaData address suggestions (required; set a real key for local development).
DADATA_API_KEY=your-dadata-api-key
# DADATA_SECRET_KEY=
# DADATA_BASE_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address
# DADATA_TIMEOUT=10s

# Web Push (VAPID). P-256 keypair (RFC 8292), base64url (no padding).
# Generate locally: see docs/research/web-push-go.md §1.1 / apps/backend push spec.
# VAPID_PUBLIC_KEY — 65 bytes uncompressed X9.62 (starts with 0x04), exposed to frontend.
# VAPID_PRIVATE_KEY — 32-byte scalar, server-only secret. NEVER commit real values.
# VAPID_SUBJECT — contact URI (mailto: or https:) for push services.
# Leaving empty disables Web Push (local dev without push is fine).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:smirnowwwivan@mail.ru

# REG.RU S3-compatible object storage for property photos.
# Use PHOTO_STORAGE_PROVIDER=fake only for temporary launches without photo uploads.
# Endpoint, bucket, access key, secret key and public base URL are required with PHOTO_STORAGE_PROVIDER=s3.
# Local defaults to fake when S3 fields are incomplete; non-local defaults to s3.
# PHOTO_STORAGE_PROVIDER=s3
# REGRU_S3_ENDPOINT=https://s3.regru.cloud
# REGRU_S3_REGION=us-east-1
# REGRU_S3_BUCKET=arenda-photos
# REGRU_S3_ACCESS_KEY=...
# REGRU_S3_SECRET_KEY=...
# REGRU_S3_PUBLIC_BASE_URL=https://s3.regru.cloud/arenda-photos
# REGRU_S3_PATH_STYLE=true
