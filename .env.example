APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=pretty

POSTGRES_PORT=5433
POSTGRES_USER=arenda
POSTGRES_PASSWORD=arenda
POSTGRES_DB=arenda
DATABASE_URL=postgres://arenda:arenda@localhost:5433/arenda?sslmode=disable
MIGRATIONS_DIR=apps/backend/db/migrations

# Cookie security: defaults to false for local, true for dev/staging/production.
# Setting COOKIE_SECURE=false explicitly is rejected for non-local environments.
COOKIE_SECURE=false

# Rate limiting defaults (all optional).
# RATE_LIMIT_IP_RPS=20
# RATE_LIMIT_IP_BURST=40
# RATE_LIMIT_PHONE_SEND_PER_HOUR=5
# RATE_LIMIT_PHONE_VERIFY_PER_15MIN=10

PHOTO_STORAGE=

# SMS sender adapter: fake (logs only) or future real provider name
SMS_SENDER=fake
# Future real provider config:
# SMS_PROVIDER_API_KEY=...
# SMS_PROVIDER_BASE_URL=...

# Payment provider adapter: fake (local dev) or future real provider name
PAYMENT_PROVIDER=fake
APP_BASE_URL=http://localhost:8080
# PAYMENT_AUTO_CONFIRM=false
# T_KASSA_TERMINAL_KEY=...
# T_KASSA_PASSWORD=...

# AES-256-GCM encryption key for sensitive data at rest (e.g. provider tokens).
# Hex (64 chars) or base64. Leave empty for pass-through/no-op encryption (local dev only).
# ENCRYPTION_KEY=

OTEL_SERVICE_NAME=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=

# DADATA_API_KEY=
# REGRU_S3_ENDPOINT=
# REGRU_S3_REGION=
# REGRU_S3_BUCKET=
# REGRU_S3_ACCESS_KEY=
# REGRU_S3_SECRET_KEY=
# REGRU_S3_PUBLIC_BASE_URL=
# REGRU_S3_PATH_STYLE=
