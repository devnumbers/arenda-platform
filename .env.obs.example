# Copy to /opt/arenda/obs/.env.obs on the server and fill real values.
# Consumed by docker-compose.obs.yml (--env-file) and expanded inside
# observability/uptrace.yml, observability/vector.yaml, observability/otelcol.yaml.

# Passwords for the observability databases.
UPTRACE_PG_PASSWORD=replace-obs-pg-password
UPTRACE_CH_PASSWORD=replace-obs-ch-password

# Secret key for signing Uptrace JWT tokens. Generate: openssl rand -hex 32
UPTRACE_SECRET=replace-with-64-hex-characters

# Uptrace web UI admin password (login: admin@rentlee.ru).
UPTRACE_ADMIN_PASSWORD=replace-obs-admin-password

# Project tokens (write access secrets). Generate: openssl rand -hex 16
# UPTRACE_SELF_TOKEN — project "Uptrace" (self-monitoring),
# UPTRACE_PROJECT_TOKEN — project "Arenda" (backend, logs, host metrics).
UPTRACE_SELF_TOKEN=replace-obs-self-token
UPTRACE_PROJECT_TOKEN=replace-obs-project-token

# DSN of the "Arenda" project. Must embed the UPTRACE_PROJECT_TOKEN value:
# http://<UPTRACE_PROJECT_TOKEN>@uptrace:14318?grpc=14317
# Used by Vector, otelcol (this stack) and by the backend
# (OTEL_EXPORTER_OTLP_HEADERS=uptrace-dsn=<same value> in .env.stage/.env.prod).
UPTRACE_DSN=http://replace-obs-project-token@uptrace:14318?grpc=14317

# Optional: Telegram bot token from @BotFather for alert notifications.
# Can be added later; restart the stack afterwards (make obs-down && make obs-up).
# UPTRACE_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
