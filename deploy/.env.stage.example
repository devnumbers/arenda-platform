# Этот файл — источник истины для состава GitHub Environment Secret ENV_FILE
# (окружение stage). Deploy-джоба рендерит .env.stage на сервере из этого
# секрета и падает при расхождении множества ключей с данным файлом.
# При добавлении/удалении ключа обнови и секрет, и этот файл.

# Строгое окружение стенда: валидация как в production, но фейковые платёжный
# провайдер и email-sender разрешены явно (тестирование без реальных денег).
APP_ENV=stage

POSTGRES_DB=arenda_stage
POSTGRES_USER=arenda_stage
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://arenda_stage:changeme@postgres:5432/arenda_stage?sslmode=disable
MIGRATIONS_DIR=/app/db/migrations

# Пул соединений PostgreSQL.
DB_MAX_CONNS=16
DB_MIN_CONNS=2

# DaData — подсказки адресов.
DADATA_API_KEY=changeme
DADATA_SECRET_KEY=changeme

# AES-256-GCM ключ шифрования чувствительных данных (hex 64 символа или base64).
# Сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY=changeme

# Доверенные прокси (CIDR через запятую) для извлечения реального IP клиента.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# APP_ENV=stage по умолчанию пишет логи в json — ключ оставлен для явности.
LOG_FORMAT=json
LOG_SUCCESSFUL_REQUESTS=false

# Отправка email.
EMAIL_SENDER=smtp
EMAIL_TEMPLATES_DIR=/app/templates/email
SMTP_HOST=smtp.stage.example.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM=no-reply@dev.rentlee.ru
SMTP_FROM_NAME=Рентли

# Ящик получателя формы «Задать вопрос» с лендинга (POST /feedback);
# пусто — эндпоинт отвечает 503, остальной продукт работает.
FEEDBACK_EMAIL=smirnowwwivan@mail.ru

# Платёжный провайдер: на стенде fake — оплаты симулируются без реальных денег.
# T-Kassa остаётся легальной на stage: при PAYMENT_PROVIDER=tkassa
# sandbox-URL https://rest-api-test.tinkoff.ru/v2/ проходит валидацию.
PAYMENT_PROVIDER=fake
APP_BASE_URL=https://dev.rentlee.ru
# Симулятор фейк-оплат (#663): браузер после «банка» возвращается во фронт
# (тот же origin, что APP_BASE_URL), оплаты подтверждаются автоматически.
# FAKE_AUTOCONFIRM=off переключает ручной режим (POST-only + fail-эндпоинт).
WEB_ORIGIN=https://dev.rentlee.ru
# Автоподтверждение включено явно (решение владельца 01.10 — тестирование
# тарифов без ручных POST-подтверждений); sentinel-суммы: копейки .01 — отказ,
# .02 — висяк до TTL, остальное — успех.
FAKE_AUTOCONFIRM=auto
T_KASSA_TERMINAL_KEY=changeme
T_KASSA_PASSWORD=changeme
T_KASSA_BASE_URL=https://rest-api-test.tinkoff.ru/v2/

# OpenTelemetry -> Uptrace (стек observability в репозитории devnumbers/observability).
# OTEL_EXPORTER_OTLP_HEADERS — uptrace-dsn, который задаётся в стеке devnumbers/observability.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://uptrace:14317
OTEL_EXPORTER_OTLP_HEADERS=uptrace-dsn=changeme
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=stage

# Web Push (VAPID): идентификация application-сервера (RFC 8292).
# Ключи P-256, base64url (без padding). Сменить ключи = сломать все живые подписки.
# Фронт получает публичный ключ в рантайме через GET /push/vapid-public-key (BFF-прокси).
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_SUBJECT=mailto:smirnowwwivan@mail.ru

# S3-совместимое хранилище REG.RU: фото объектов и off-site бэкапы.
PHOTO_STORAGE_PROVIDER=fake
REGRU_S3_ENDPOINT=https://s3.regru.cloud
REGRU_S3_REGION=ru-1
REGRU_S3_BUCKET=changeme
REGRU_S3_ACCESS_KEY=changeme
REGRU_S3_SECRET_KEY=changeme
REGRU_S3_PUBLIC_BASE_URL=https://changeme.example.com
REGRU_S3_PATH_STYLE=true
