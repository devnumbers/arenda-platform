# Этот файл — источник истины для состава GitHub Environment Secret ENV_FILE
# (окружение production). Deploy-джоба рендерит .env.prod на сервере из этого
# секрета и падает при расхождении множества ключей с данным файлом.
# При добавлении/удалении ключа обнови и секрет, и этот файл.

APP_ENV=production

POSTGRES_DB=arenda_prod
POSTGRES_USER=arenda_prod
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://arenda_prod:changeme@postgres:5432/arenda_prod?sslmode=disable
MIGRATIONS_DIR=/app/db/migrations

# Пул соединений PostgreSQL.
DB_MAX_CONNS=32
DB_MIN_CONNS=4

# DaData — подсказки адресов.
DADATA_API_KEY=changeme
DADATA_SECRET_KEY=changeme

# AES-256-GCM ключ шифрования чувствительных данных (hex 64 символа или base64).
# Сгенерировать: openssl rand -hex 32
ENCRYPTION_KEY=changeme

# Доверенные прокси (CIDR через запятую) для извлечения реального IP клиента.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

LOG_SUCCESSFUL_REQUESTS=false

# Отправка email.
EMAIL_SENDER=smtp
EMAIL_TEMPLATES_DIR=/app/templates/email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM=no-reply@rentlee.ru
SMTP_FROM_NAME=Rentlee

# Платёжный провайдер (T-Kassa, боевой API).
PAYMENT_PROVIDER=tkassa
APP_BASE_URL=https://rentlee.ru
T_KASSA_TERMINAL_KEY=changeme
T_KASSA_PASSWORD=changeme
T_KASSA_BASE_URL=https://securepay.tinkoff.ru/v2/

# OpenTelemetry -> Uptrace (стек observability в репозитории devnumbers/observability).
# OTEL_EXPORTER_OTLP_HEADERS — uptrace-dsn, который задаётся в стеке devnumbers/observability.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://uptrace:14317
OTEL_EXPORTER_OTLP_HEADERS=uptrace-dsn=changeme
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# S3-совместимое хранилище REG.RU: фото объектов и off-site бэкапы.
PHOTO_STORAGE_PROVIDER=fake
REGRU_S3_ENDPOINT=https://s3.regru.cloud
REGRU_S3_REGION=ru-1
REGRU_S3_BUCKET=changeme
REGRU_S3_ACCESS_KEY=changeme
REGRU_S3_SECRET_KEY=changeme
REGRU_S3_PUBLIC_BASE_URL=https://changeme.example.com
REGRU_S3_PATH_STYLE=true
