# Copy this file to /opt/arenda/prod/.env.prod on the server.
# Keep DATABASE_URL credentials in sync with POSTGRES_* values.

POSTGRES_DB=arenda_prod
POSTGRES_USER=arenda_prod
POSTGRES_PASSWORD=replace-prod-db-password

APP_ENV=production
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SUCCESSFUL_REQUESTS=false
DATABASE_URL=postgres://arenda_prod:replace-prod-db-password@postgres:5432/arenda_prod?sslmode=disable
MIGRATIONS_DIR=/app/db/migrations
COOKIE_SECURE=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

DB_MAX_CONNS=32
DB_MIN_CONNS=4
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=60s

RATE_LIMIT_IP_RPS=20
RATE_LIMIT_IP_BURST=40
RATE_LIMIT_EMAIL_SEND_PER_HOUR=60
RATE_LIMIT_EMAIL_VERIFY_PER_15MIN=30

SMS_SENDER=disabled
EMAIL_SENDER=smtp
EMAIL_TEMPLATES_DIR=/app/templates/email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-prod-smtp-user
SMTP_PASS=replace-prod-smtp-password
SMTP_FROM=no-reply@rentlee.ru
SMTP_FROM_NAME=Rentlee
SMTP_TIMEOUT=10s

APP_BASE_URL=https://rentlee.ru
PAYMENT_PROVIDER=tkassa
T_KASSA_TERMINAL_KEY=replace-prod-terminal-key
T_KASSA_PASSWORD=replace-prod-terminal-password
T_KASSA_BASE_URL=https://securepay.tinkoff.ru/v2/
T_KASSA_TIMEOUT=30s

DADATA_API_KEY=replace-prod-dadata-api-key
DADATA_SECRET_KEY=replace-prod-dadata-secret-key
DADATA_BASE_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address
DADATA_TIMEOUT=10s

PHOTO_STORAGE_PROVIDER=s3
REGRU_S3_ENDPOINT=https://s3.regru.cloud
REGRU_S3_REGION=ru-1
REGRU_S3_BUCKET=replace-prod-bucket
REGRU_S3_ACCESS_KEY=replace-prod-s3-access-key
REGRU_S3_SECRET_KEY=replace-prod-s3-secret-key
REGRU_S3_PUBLIC_BASE_URL=https://cdn.rentlee.ru
REGRU_S3_PATH_STYLE=true

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

BILLING_WORKER_INTERVAL=1h
PAYMENT_RECONCILIATION_WORKER_INTERVAL=5m
OVERDUE_OPERATION_WORKER_INTERVAL=24h
TARIFF_CACHE_TTL=5m
